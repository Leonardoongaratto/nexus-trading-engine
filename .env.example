# Exemplo de configuração de ambiente para XAU-BOT
XAU_ENV=development
XAU_SYMBOL=XAUUSD
XAU_TIMEFRAME_ENTRY=M5
XAU_BROKER_TYPE=sim

# Credenciais MetaTrader 5 (quando XAU_BROKER_TYPE=mt5)
XAU_MT5_LOGIN=12345678
XAU_MT5_PASSWORD=sua_senha_aqui
XAU_MT5_SERVER=MetaQuotes-Demo

# Parâmetros de Risco e Execução
XAU_RISK_PER_TRADE_PCT=1.0
XAU_MAX_DAILY_LOSS_PCT=3.0
XAU_MAX_DRAWDOWN_PCT=10.0
XAU_MAX_CONSECUTIVE_LOSSES=3
XAU_MAX_DAILY_TRADES=5
XAU_EXECUTION_MODE=semiauto
XAU_JOURNAL_DB=journal.db
